{
    "name": "coyotito/ipp",
    "description": "A clean, standards-compliant IPP (Internet Printing Protocol — RFC 8011/8010) client for PHP: discover network printers, read their capabilities, and submit print jobs — vendor and model agnostic.",
    "type": "library",
    "license": "MIT",
    "keywords": ["ipp", "printing", "cups", "rfc8011", "rfc8010", "printer", "ipp-everywhere", "airprint"],
    "authors": [
        {
            "name": "asciito",
            "homepage": "https://github.com/asciito"
        }
    ],
    "require": {
        "php": "^8.4",
        "clue/socket-raw": "^1.6",
        "guzzlehttp/guzzle": "^7.9",
        "symfony/process": "^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Coyotito\\Ipp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Coyotito\\Ipp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "format": "pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
